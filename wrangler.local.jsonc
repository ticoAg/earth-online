{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Test-only configuration: every binding is simulated locally, with no account credentials.
  "name": "earth-online-local-tests",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earth-online-local-tests",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
